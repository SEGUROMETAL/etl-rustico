version: "3.8"

services:
  clickhouse-server:
    container_name: ch_reportes
    image: clickhouse/clickhouse-server:latest
    restart: unless-stopped
    ports:
      - "8123:8123"   # HTTP interface
      - "9000:9000"   # Native protocol (usado por Superset)
    environment:
      CLICKHOUSE_DB: reportes
      CLICKHOUSE_USER: fexa
      CLICKHOUSE_PASSWORD: 8235
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - clickhouse-data:/var/lib/clickhouse
      - clickhouse-logs:/var/log/clickhouse-server

volumes:
  clickhouse-data:
  clickhouse-logs:
